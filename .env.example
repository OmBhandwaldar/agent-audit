# Algorand
ALGORAND_NODE_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
DEPLOYER_MNEMONIC=your_25_word_mnemonic_here

# Phase 2 contracts (set after running scripts/deploy_phase2.py)
POLICY_APP_ID=
ANCHOR_APP_ID=
COMPLIANCE_ASA_ID=

# IPFS / Pinata
PINATA_JWT=your_pinata_jwt_token

# AI Agent
GROQ_API_KEY=your_groq_api_key

# Encryption — 32 bytes hex (generate with: python scripts/gen_encryption_key.py)
PAYLOAD_ENCRYPTION_KEY=your_64_char_hex_key

# Batching (optional — defaults shown)
BATCH_SIZE=50
BATCHER_DB_PATH=data/batcher.db

# Tenancy (optional — default shown)
TENANTS_DB_PATH=data/tenants.db

# x402 pay-per-call gate (optional — OFF by default). Protects POST /v1/audit/x402.
X402_ENABLED=false
X402_RECIPIENT=                       # Algorand address that receives USDC (must opt into USDC)
X402_FACILITATOR_URL=https://www.x402.org/facilitator
X402_PRICE_MICRO=10000                # micro-USDC; 10000 = $0.01
# X402_PAYER_MNEMONIC=                # only for the paying-agent example / opt_in_usdc.py

# App
POLICY_LIMIT=5000
AGENT_ID=agent_001
